# API Configuration
# Replace <YOUR_PC_IP> with your actual local network IP (e.g., 192.168.1.100)
# To find your IP: Windows: ipconfig | Linux/Mac: ifconfig or ip addr
VITE_API_BASE_URL=http://localhost:4000/api

